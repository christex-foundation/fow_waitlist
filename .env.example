# Airtable credentials for the /api/waitlist serverless function.
# In production, set these in Vercel → Project → Settings → Environment Variables.
# For local development with `vercel dev`, copy this file to `.env`
# (or run `vercel env pull`).

# Airtable Personal Access Token (keep secret — never commit the real value)
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# Airtable base id, e.g. appXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Table name (optional; defaults to "Waitlist")
AIRTABLE_TABLE=Waitlist
